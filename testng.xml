<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Interview Preparation Framework" parallel="methods"
	thread-count="8" verbose="1">
	<listeners>
        <listener class-name="com.ui.listeners.TestListener" />
    </listeners>
	<test name="Valid Login Test">
		<parameter name="browser" value="chrome"></parameter>
		<parameter name="isLambdaTest" value="false"></parameter>
		<parameter name="isHeadless" value="false"></parameter>
		<classes>
			<class name="com.ui.tests.LoginTest" />
		</classes>
	</test>
		<test name="Invalid Login Test">
		<parameter name="browser" value="chrome"></parameter>
		<parameter name="isLambdaTest" value="false"></parameter>
		<parameter name="isHeadless" value="false"></parameter>
		<classes>
			<class name="com.ui.tests.InvalidLoginTest" />
		</classes>
	</test>
</suite>	